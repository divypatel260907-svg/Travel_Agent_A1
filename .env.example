# ==============================================================================
# VOYA Travel Planner - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Flask Session & Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=1

# Groq API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (Optional review step, free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
ENABLE_GEMINI_REVIEW=false

# Database Configuration (Leave unset for default SQLite)
# For Render PostgreSQL: postgresql://user:password@host/dbname
# DATABASE_URL=sqlite:///instance/travel.db

# CORS Allowed Origins (Comma-separated URLs for your production domain)
# Example: https://voya-travel.onrender.com
ALLOWED_ORIGINS=

# Rate Limiting
RATELIMIT_DEFAULT=200 per day; 50 per hour
