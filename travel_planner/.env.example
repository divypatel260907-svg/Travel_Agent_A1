# ─── Required LLM Keys ────────────────────────────────────────────────────────
# Get a free Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get a free Groq key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── Optional / Free-key APIs ─────────────────────────────────────────────────
# OpenTripMap (free tier) – https://opentripmap.io/register
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# ─── LLM model selection (defaults shown) ─────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash

# ─── App settings ─────────────────────────────────────────────────────────────
# Preference memory: "session" (default, no persistence) or "local" (SQLite)
PREFERENCE_STORAGE=session
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
